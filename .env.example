# ============================================
# Shivam Electronic World — Environment Variables
# ============================================
# Copy this file to .env in both /backend and /frontend
# and fill in the values specific to your environment.

# ── BACKEND (.env inside /backend) ──────────
# MongoDB Connection
MONGODB_URI=

# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173,https://shivamelectronic.vercel.app

# Cloudinary Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin Credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=
JWT_SECRET=

# Email (Gmail SMTP) - for OTP password reset
EMAIL_USER=
EMAIL_PASS=

# Sentry Error Tracking DSN (Server-side)
SENTRY_DSN=


# ── FRONTEND (.env inside /frontend) ────────
# Backend API URL
VITE_API_URL=http://localhost:5000

# Sentry Error Tracking DSN (Client-side)
VITE_SENTRY_DSN=
